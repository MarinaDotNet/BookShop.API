@page
@model BookShop.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Welcome to the BookShop";
}

@if(Model.IsApiAwakening){
    <div class="api-awakening">
        <h3 class="mb-3">BookShop API is currently sleeping.</h3>
        <p class="mb-3">
            This demo is hosted on Render's free plan. After a period of inactivity the API automatically goes to sleep and needs
            a short time to start again.
        </p>

        <p class="mb-3">
            Startup usually takes <strong>30-90 seconds</strong>.
        </p>
            
        <div class="alert alert-info mt-3">
            <strong>Tip</strong><br/>
            The API currently needs to be woken up manually.<br/>
            Open the Swagger page in a new tab, wait until it loads, then return here and refresh this page.
        </div>

        <a class="btn btn-add me-2" target="_blank" href="https://bookshop-api-xyxs.onrender.com/swagger">Open API (Swagger)</a>
            
        <button onclick="window.location.reload();" class="btn btn-details">Refresh Status</button><br/>

        <small class="text-muted">
            Note: On the Render free plan, the API may go  back to sleep after approximately <strong>15 minutes</strong> of inactivity.
        </small>
        <p class="mt-3 mb-0 fw-semibold">Thank you for your patience!</p>
        </div>
}
<div class="row g-4">
    @foreach(var book in Model.Books)
    {
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100">

                <div class="card-img-top d-flex justify-content-center align-items-center" style="height:250px;font-size:5rem">
                    📚
                </div>

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@book.Title</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@string.Join(",", book.Authors)</h6>

                    <div class="mb-3">
                        @foreach(var genre in book.Genres)
                        {
                            <a asp-page="/Catalog/Filters" asp-route-name="@genre" class="badge genre-badge me-1 mb-1">@genre</a>
                        }
                    </div>

                    <p class="card-text book-description">@book.Annotation</p>
                    
                    <div class="card-actions mt-auto">
                        <h4 class="d-flex gap-2 book-price">$@book.Price</h4>
                        <button class="btn btn-details flex-fill">Details</button>
                        <button class="btn btn-add flex-fill">Add to Cart</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>