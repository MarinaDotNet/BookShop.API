@page
@model BookShop.Web.Pages.Auth.LogoutModel
@{
    ViewData["Title"] = "Login";
}

@if(Model.IsApiAwakening)
{
    <partial name="_ApiAwakening" model='new ApiAwakeningViewModel{ Operation = ApiOperation.Logout}' />
}
else
{
    <form method="post" asp-page="/Auth/Logout">
        @Html.AntiForgeryToken()
        
        <button type="submit" class="btn btn-add">Logout</button>
    </form>
}

