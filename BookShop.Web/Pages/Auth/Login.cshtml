@page
@model BookShop.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Login";
}
@if(Model.IsApiAwakening)
{
    <partial name="_ApiAwakening" model='new ApiAwakeningViewModel{ Operation = ApiOperation.Login}' />
}
else 
{
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">
            <div class="login-card">
                <div class="card-body p-5">
                    <h2 class="text-center mb-4 card-title">Login</h2>
                    <form method="post" asp-page="/Auth/Login" type="submit">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Login.Email" class="form-label card-subtitle">Email:</label>
                            <input asp-for="Login.Email" class="form-control" type="email"/>
                            <span asp-validation-for="Login.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Login.Password" class="form-label card-subtitle">Password:</label>
                            <input asp-for="Login.Password" class="form-control" type="password"/>
                            <span asp-validation-for="Login.Password" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-add">Login</button>
                            <a asp-page="/Auth/Register" class="btn btn-add">Create account</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}



